{
  "name": "code-parliament",
  "version": "1.0.0",
  "description": "AI Code Review Parliament - 3 agents debate your code quality",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "code-parliament": "./dist/index.js",
    "parliament-notify": "./dist/notify.js"
  },
  "scripts": {
    "build": "tsc && npm run copy-assets",
    "copy-assets": "mkdir -p dist/dashboard/public dist/agents/prompts && cp -r src/dashboard/public/* dist/dashboard/public/ && cp -r src/agents/prompts/* dist/agents/prompts/",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "daemon": "node dist/daemon/index.js",
    "dashboard": "node dist/dashboard/server.js",
    "test": "vitest"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.52.0",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "better-sqlite3": "^11.0.0",
    "chokidar": "^3.6.0",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "p-queue": "^8.0.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.9",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vitest": "^1.2.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
