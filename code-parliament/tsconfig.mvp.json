{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "declaration": false
  },
  "include": [
    "src/mcp-simple.ts",
    "src/autofix.ts",
    "src/daemon-simple.ts",
    "src/utils/json-parser.ts",
    "src/utils/import-graph.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
